<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: wraps naturally in portrait and landscape -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_title"
                    android:textColor="@color/primary_accent"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/header_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_bg_purple"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="ARM64"
                    android:textColor="@color/purple_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtVersionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/badge_bg_green"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="v—"
                    android:textColor="@color/success_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- One-column list; the ScrollView handles short screens and rotation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Game status, quality and disc installer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Card 1: Game Status & Hero Launch -->
                <LinearLayout
                    android:id="@+id/cardGameStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Estado del juego"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtGameStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_bg_amber"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="FALTA INSTALAR"
                            android:textColor="@color/warning_amber"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtGameStatusDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="No se detectan los datos del juego. Elige tu archivo para instalarlos."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnLaunchGame"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/btn_success"
                        android:text="@string/btn_launch_game"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Single setting shared with the in-game graphics setting -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Calidad gráfica"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtQualityCurrent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Calidad guardada: leyendo ajustes…"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                         android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnRes480"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_secondary"
                            android:minWidth="0dp"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:text="480p"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnRes720"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:background="@drawable/btn_secondary"
                            android:minWidth="0dp"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:text="720p"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnRes1080"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:background="@drawable/btn_secondary"
                            android:minWidth="0dp"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:text="1080p"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnRes1440"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:background="@drawable/btn_secondary"
                            android:minWidth="0dp"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:text="1440p"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnRes4K"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:background="@drawable/btn_secondary"
                            android:minWidth="0dp"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:text="4K"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnResetData"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/btn_danger"
                        android:text="Restablecer datos del juego"
                        android:textColor="@color/error_red"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Card 2: Game Disc Installer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:padding="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_source"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Selecciona una copia de juego compatible."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnBrowseGameFiles"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_secondary"
                        android:text="@string/btn_browse_game_files"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/hint_browse_game_files"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtSourcePath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/console_bg"
                        android:padding="8dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:text="@string/no_source_selected"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                         android:orientation="vertical">

                        <Button
                            android:id="@+id/btnSelectDisc"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/btn_primary"
                            android:text="@string/btn_select_disc"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnAutoDetect"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/btn_secondary"
                            android:text="@string/btn_auto_detect"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/chkIncludeMovies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:checked="false"
                        android:text="@string/include_movies"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnStartCooking"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_primary"
                        android:text="@string/btn_start_cook"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Graphics driver, diagnostics and credits -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp">

                <!-- Card 3: GPU Driver Manager -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/title_gpu_driver"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDriverStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_bg_blue"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="SISTEMA"
                            android:textColor="@color/primary_accent"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtGpuHardwareInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Dispositivo gráfico: detectando…"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtDriverDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/console_bg"
                        android:padding="8dp"
                        android:fontFamily="monospace"
                        android:text="Activo: controlador incluido por el sistema"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                         android:orientation="vertical">

                        <Button
                            android:id="@+id/btnInstallDriver"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="@drawable/btn_secondary"
                            android:text="Instalar controlador (.zip)"
                            android:textColor="@color/primary_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnResetDriver"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/btn_secondary"
                            android:text="Volver al controlador del sistema"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/driver_help_text"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Card 4: Console Output & Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="18dp"
                    android:padding="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Actividad y diagnóstico"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnCopyStartupReport"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/btn_secondary"
                        android:text="Copiar informe"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnClearLog"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/btn_secondary"
                        android:text="Vaciar registro"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtProgressStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/status_ready"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:progressDrawable="@drawable/progress_bar_custom"
                        android:max="100"
                        android:progress="0"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtLogOutput"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/console_bg"
                        android:padding="8dp"
                        android:fontFamily="monospace"
                        android:scrollbars="vertical"
                        android:textColor="@color/log_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:paddingTop="12dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/text_muted" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Registro de cambios"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Qué cambió y cómo funciona cada parte: motor, gráficos, texturas, audio, controles, mods, rendimiento y conversión."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <Button
                        android:id="@+id/btnViewChangelog"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_secondary"
                        android:text="Ver registro de cambios detallado"
                        android:textColor="@color/primary_accent"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Créditos y licencias"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Galaxy Android · GPL-3.0&#10;Fork y mantenimiento Android: Unncpmas. El código original se atribuye a sus autores y proyectos upstream."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Petari / SMGCommunity · CC0 1.0&#10;GalaxyQuest / bigmak94 · The Unlicense&#10;LukeValen · reconocimiento por el soporte de renderizado Mali"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Avisos de terceros: MIT, SIL OFL, Apache 2.0 y otras licencias indicadas en los avisos del proyecto."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/console_bg"
                        android:padding="10dp"
                        android:text="Proyecto no oficial y sin afiliación con Nintendo. Los juegos, marcas y archivos de juego pertenecen a sus titulares. Estos créditos no conceden derechos sobre sus materiales."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp" />

                    <Button
                        android:id="@+id/btnViewLicenses"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_secondary"
                        android:text="Leer licencias y avisos completos"
                        android:textColor="@color/primary_accent"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
